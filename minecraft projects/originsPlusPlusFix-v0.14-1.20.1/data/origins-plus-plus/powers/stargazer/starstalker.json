{
  "loading_priority": 10,
  "type": "origins:multiple",
  "resource": {
    "type": "origins:resource",
    "max": 300,
    "min": 0,
    "start_value": 300,
    "hud_render": {
      "sprite_location": "origins:textures/gui/community/huang/resource_bar_01.png",
      "bar_index": 5
    }
  },
  "toggle": {
    "type": "origins:toggle",
    "key": "key.origins.secondary_active",
    "active_by_default": false
  },
  "invulnerability": {
    "type": "origins:invulnerability",
    "damage_condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:name",
          "name": "inWall"
        },
        {
          "type": "origins:name",
          "name": "fall"
        }
      ]
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        },
        {
          "type": "origins:health",
          "comparison": ">",
          "compare_to": 1
        }
      ]
    }
  },
  "weak": {
    "type": "origins:stacking_status_effect",
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        },
        {
          "type": "origins:health",
          "comparison": ">",
          "compare_to": 1
        }
      ]
    },
    "min_stacks": 0,
    "max_stacks": 1,
    "duration_per_stack": 20,
    "effect": {
      "show_particles": false,
      "show_icon": false,
      "effect": "minecraft:weakness",
      "amplifier": 100
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:power_active",
        "power": "*:*_toggle"
      },
      "if_action": {
        "type": "origins:change_resource",
        "resource": "*:*_resource",
        "change": -3
      },
      "else_action": {
        "type": "origins:change_resource",
        "resource": "*:*_resource",
        "change": 2
      }
    }
  },
  "poison": {
    "type": "origins:stacking_status_effect",
    "min_stacks": 0,
    "max_stacks": 1,
    "duration_per_stack": 20,
    "effect": {
      "show_particles": false,
      "show_icon": false,
      "effect": "minecraft:poison",
      "amplifier": 1
    },
    "condition": {
      "type": "origins:resource",
      "comparison": "==",
      "resource": "*:*_resource",
      "compare_to": 0
    }
  },
  "phase": {
    "type": "origins:phasing",
    "blacklist": true,
    "render_type": "blindness",
    "view_distance": 20,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        },
        {
          "type": "origins:health",
          "comparison": ">",
          "compare_to": 1
        }
      ]
    },
    "block_condition": {
      "type": "origins:in_tag",
      "tag": "origins:unphasable"
    },
    "phase_down_condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        },
        {
          "type": "origins:health",
          "comparison": ">",
          "compare_to": 1
        },
        {
          "type": "origins:or",
          "conditions": [
            {
              "type": "origins:swimming"
            },
            {
              "type": "origins:sneaking"
            }
          ]
        }
      ]
    }
  }
}
