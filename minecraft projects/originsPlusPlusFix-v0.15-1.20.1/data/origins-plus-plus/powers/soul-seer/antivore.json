{
  "loading_priority": 10,
  "type": "origins:multiple",
  "resource": {
    "type": "origins:resource",
    "min": 0,
    "max": 6,
    "hud_render": {
      "should_render": false
    }
  },
  "charge": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_resource",
      "change": 3
    },
    "interval": 15,
    "condition": {
      "type": "origins:using_item",
      "item_condition": {
        "type": "origins:food"
      }
    }
  },
  "deplete": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_resource",
      "change": -6
    },
    "interval": 200
  },
  "respawn": {
    "type": "origins:action_on_callback",
    "entity_action_respawned": {
      "type": "origins:change_resource",
      "resource": "*:*_resource",
      "change": -6
    }
  },
  "finally": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "summon minecraft:tnt ~ ~ ~"
    },
    "interval": 20,
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_resource",
      "comparison": "==",
      "compare_to": 6
    }
  }
}
