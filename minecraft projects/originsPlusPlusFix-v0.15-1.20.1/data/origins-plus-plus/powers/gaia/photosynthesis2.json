{
  "name": "power.origins-plus-plus.gaia/photosynthesis.name",
  "description": "power.origins-plus-plus.gaia/photosynthesis.description",
  "loading_priority": 10,
  "type": "origins:multiple",
  "regenerate_food": {
    "type": "origins:action_over_time",
    "interval": 50,
    "entity_action": {
      "type": "origins:feed",
      "food": 1,
      "saturation": 0.5
    },
    "condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:in_block",
          "block_condition": {
            "type": "origins:light_level",
            "comparison": ">=",
            "compare_to": 15
          }
        },
        {
          "type": "origins:and",
          "conditions": [
            {
              "type": "origins:daytime"
            },
            {
              "type": "origins:exposed_to_sky"
            }
          ]
        }
      ]
    }
  }
}
